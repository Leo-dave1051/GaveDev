{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build PaintHeist",
      "type": "shell",
      "command": "javac",
      "args": [
        "-d",
        "out",
        "src/Main.java",
        "src/core/*.java",
        "src/states/*.java",
        "src/entities/*.java",
        "src/world/*.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac"
    }
  ]
}
